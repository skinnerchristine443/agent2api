HOST=127.0.0.1
PORT=3010
# SQLite 账号注册表与持久化的账号凭证。留空 = $HOME/.agent2api。
# ⚠️ 本地开发不要照抄容器路径 /data（compose 侧已固定；本地写 /data 会在
# MkdirAll 时因权限失败）。
# AGENT2API_DATA_DIR=/data
AGENT2API_RUNTIME_DIR=/tmp/agent2api-runtime

# Console（运维）面。
# console key 用于解锁 /api/*；proxy key（自动生成）驱动 /v1/*。
# 二者相互独立：首启即各生成随机值——TTY 下各打印一次，非 TTY
# （容器等）写入数据目录 initial-keys.txt（0600）。
# 既有部署（历史上 console key 曾由 proxy key 播种）保持原值可用，
# 启动日志会提示轮换一次完成拆分。
# 注意：此值仅在首次运行时播种（空库）。一旦数据库中
# 存在 console_key，修改此变量即无效果 —— 请改为在
# console 中轮换。
# AGENT2API_CONSOLE_KEY=
# 除回环（127.0.0.1 / ::1）外，允许访问 console 的额外
# 来源网络。留空表示仅回环。CIDR 或裸 IP，以逗号/空格分隔。
# 相比扩大此列表，优先使用在宿主机上终止的隧道。
# AGENT2API_CONSOLE_ALLOWED_CIDRS=203.0.113.7,10.8.0.0/24

# 可选的托管更新集成。
# AGENT2API_UPDATE_SOCKET_PATH=/run/agent2api-updater/updater.sock
# macOS/Windows 上的 Docker Desktop：
# AGENT2API_UPDATE_AGENT_URL=http://host.docker.internal:3011
# AGENT2API_UPDATE_AGENT_TOKEN=
# AGENT2API_UPDATE_GITHUB_TOKEN=

# 进程级选项（审查 T48 补齐；此前散落于代码而样例缺位）。
# 内部状态根：仅当 AGENT2API_DATA_DIR 未设置时用于推导兜底数据目录。
# AGENT2API_HOME=/var/lib/agent2api
# 单次请求最多轮换尝试的账号数（1–64，默认 4；非法或越界值将拒绝启动）。
# AGENT2API_MAX_RETRY_ACCOUNTS=4
# 出站 HTTP/SOCKS 代理（为空直连；账号级代理设置优先于此）。
# AGENT2API_PROXY_URL=
# 调试端点 /debug/pprof（默认关；仍受 console key 与来源闸保护）。
# AGENT2API_ENABLE_PPROF=0
# 数据面（/v1/*）CORS 来源白名单（D-2）。留空 = 维持通配（*）；
# 填写后仅这些来源可跨域调用（逗号/空格分隔；浏览器端客户端需列在此）。
# AGENT2API_CORS_ORIGINS=https://your-app.example

# 可选的上游线路对齐开关。默认全部关闭，且会改变
# 上游所看到的内容，因此只在确实需要它们的真实账号上启用。
# Trae：在每次签到流程中配对一个全新的数字 device id。默认关闭——
# 它会改变上游所见内容，且设备号反复变化本身就是风控信号。9074 已由
# 「生成与存量归一都钉在合法值域」解决，不需要靠它。
# AGENT2API_TRAE_FRESH_CHECKIN_DEVICE=1
# WorkBuddy 的内容筛查缓解。两者默认开启；设为 0 可
# 关闭。sanitizer 会剥离或最小限度地改写出站聊天消息中已知的筛查
# 指纹（它会改写消息文本，因此仅当它干扰真实内容时才关闭）。
# degrade gate 会在出现 missing-system-prompt 或
# content-screening 拒绝后丢弃 WorkBuddy 调用方的
# system prompt，直到下一个本地午夜。
# AGENT2API_WORKBUDDY_SANITIZE=0
# AGENT2API_WORKBUDDY_DEGRADE_GATE=0
# WorkBuddy：prompt_cache_key 注入（默认关——2026-10-09 实测：无键已有
# 自动前缀缓存，注入无稳定收益；=1 启用，仅用于复测或上游变化后的 A/B，
# 见 workbuddy/cachekey.go）。
# AGENT2API_WORKBUDDY_CACHE_KEY=1
# 流式线路对齐。默认全部关闭。
# 保持下游状态不发送，直到上游产出其首个决定性
# 帧，这样首个 token 之前的失败会以真实 HTTP 状态
# 到达客户端，而不是在已提交的 200 上以带内文本形式出现。
# AGENT2API_STREAM_HEAD_GATE=1
# AGENT2API_STREAM_HEAD_TIMEOUT=30s
# 保持静默的流存活（SSE comment 行），使本网关前方的
# 空闲超时无法切断漫长的思考阶段。
# AGENT2API_STREAM_HEARTBEAT=1
# AGENT2API_STREAM_HEARTBEAT_INTERVAL=15s
