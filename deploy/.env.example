# AGENT2API_IMAGE=ghcr.io/skinnerchristine443/agent2api:latest

# 用于发布检查的可选 GitHub token。
# AGENT2API_UPDATE_GITHUB_TOKEN=
# macOS 与 Windows 安装程序会把回环更新器 endpoint 与 token 写入这里。
# AGENT2API_UPDATE_AGENT_URL=
# AGENT2API_UPDATE_AGENT_TOKEN=
# Linux socket 目录，或一个无害的 Docker Desktop 占位目录。
# AGENT2API_UPDATER_SOCKET_DIR=/run/agent2api-updater
# 容器非 root 运行时访问宿主更新器 socket 所需的组 gid
# （socket 为 root:root 0660，默认附加 gid 0 组即可；宿主另行
# 按独立组隔离时填该组数字 gid）。
# AGENT2API_UPDATER_GID=0

# 进程级选项（compose 透传；审查 T48 补齐）。
# AGENT2API_MAX_RETRY_ACCOUNTS=4
# AGENT2API_ENABLE_PPROF=0
# 数据面（/v1/*）CORS 来源白名单（D-2）：留空 = 通配 *；填写后仅白名单来源可跨域。
# AGENT2API_CORS_ORIGINS=
# AGENT2API_PROXY_URL=
# （AGENT2API_HOME 无需在容器内设置：数据/运行目录由镜像固定为 /data 与 /run/agent2api。）

# Console（运维）面。console key 用于解锁 /api/*，与 proxy key 相互
# 独立（首启各自生成随机值；非终端环境写入 /data/initial-keys.txt，
# TTY 下打印一次）；既有部署保持原值可用，在 console 中轮换一次即完成拆分。
# AGENT2API_CONSOLE_KEY=
# 除回环外，允许访问 console 的额外来源网络。compose 文件
# 已默认将其设为 Docker bridge 网段（关于在仅发布回环端口的前提下
# 为何安全，见该处注释）。
# AGENT2API_CONSOLE_ALLOWED_CIDRS=

# 可选的上游线路对齐开关。默认全部关闭，且会改变
# 上游所看到的内容，因此只在确实需要它们的真实账号上启用。
# Trae：在每次签到流程中配对一个全新的数字 device id。
# AGENT2API_TRAE_FRESH_CHECKIN_DEVICE=1
# WorkBuddy 的内容筛查缓解。两者默认开启；设为 0 可
# 关闭。sanitizer 会剥离或最小限度地改写出站聊天消息中已知的筛查
# 指纹（它会改写消息文本，因此仅当它干扰真实内容时才关闭）。
# degrade gate 会在出现 missing-system-prompt 或
# content-screening 拒绝后丢弃 WorkBuddy 调用方的
# system prompt，直到下一个本地午夜。
# AGENT2API_WORKBUDDY_SANITIZE=0
# AGENT2API_WORKBUDDY_DEGRADE_GATE=0
# WorkBuddy：prompt_cache_key 注入（默认关——2026-10-09 实测：无键已有
# 自动前缀缓存，注入无稳定收益；=1 启用，仅用于复测或上游变化后的 A/B，
# 见 workbuddy/cachekey.go）。
# AGENT2API_WORKBUDDY_CACHE_KEY=1
# 流式线路对齐。
# 保持下游状态不发送，直到上游产出其首个决定性
# 帧，这样首个 token 之前的失败会以真实 HTTP 状态
# 到达客户端，而不是在已提交的 200 上以带内文本形式出现。
# 默认关：会把响应头延迟到首 token，截止时间需按最慢模型实测后设定。
# AGENT2API_STREAM_HEAD_GATE=1
# AGENT2API_STREAM_HEAD_TIMEOUT=30s
# 保持静默的流存活（SSE comment 行），使本网关前方的
# 空闲超时无法切断漫长的思考阶段。
# 默认关（代码契约）。deep-reasoning 的思考静默期可能接近或超过
# nginx 默认 60s 读超时，因此生产建议开启（=1）。
# AGENT2API_STREAM_HEARTBEAT=1
# AGENT2API_STREAM_HEARTBEAT_INTERVAL=15s

# 对话活跃上报（点亮 growth 连登）。默认关闭：上游 /v2/report 通道需先
# A/B 取证（见 docs/03），取证通过后再开启。每号每天 1 次，本地时刻可配。
# AGENT2API_ACTIVITY_REPORT=1
# AGENT2API_ACTIVITY_REPORT_TIME=09:00
